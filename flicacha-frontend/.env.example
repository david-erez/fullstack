# URL base de la API del backend (compartida por tu compañero de backend)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Pon esto en "true" SOLO si el backend responde en snake_case
# (tal como están las columnas en mer.puml: user_id, post_id, created_at, etc.)
# El cliente convertirá automáticamente snake_case <-> camelCase.
# Si el backend ya normaliza las respuestas a camelCase, déjalo en "false".
EXPO_PUBLIC_API_SNAKE_CASE=false
