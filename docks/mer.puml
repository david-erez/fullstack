@startuml Flicacha_MER

entity users {
  PK user_id        : BIGINT
  --
  name              : VARCHAR(30) <<UNIQUE>>
  email             : VARCHAR(50) <<UNIQUE>>
  password_hash     : VARCHAR(255)
  avatar_url        : VARCHAR(500)
  is_active         : BOOLEAN
  created_at        : TIMESTAMPTZ
  updated_at        : TIMESTAMPTZ
}

entity posts {
  PK post_id        : BIGINT
  --
  FK user_id        : BIGINT
  content           : VARCHAR(280)
  is_visible        : BOOLEAN
  created_at        : TIMESTAMPTZ
  updated_at        : TIMESTAMPTZ
}

entity comments {
  PK comment_id     : BIGINT
  --
  FK post_id        : BIGINT
  FK user_id        : BIGINT
  content           : VARCHAR(500)
  created_at        : TIMESTAMPTZ
}

entity notifications {
  PK notification_id : BIGINT
  --
  FK user_id         : BIGINT
  FK actor_id        : BIGINT
  type               : VARCHAR(30)
  reference_id       : BIGINT
  is_read            : BOOLEAN
  created_at         : TIMESTAMPTZ
}

entity media_files {
  PK media_id       : BIGINT
  --
  FK post_id        : BIGINT
  url               : VARCHAR(500)
  media_type        : VARCHAR(20)
  created_at        : TIMESTAMPTZ
}

' ── Pivot / Junction tables ───────────────────
entity post_likes {
  PK FK user_id     : BIGINT
  PK FK post_id     : BIGINT
  --
  created_at        : TIMESTAMPTZ
}

entity user_follows {
  PK FK follower_id  : BIGINT
  PK FK following_id : BIGINT
  --
  created_at         : TIMESTAMPTZ
}

entity comment_likes {
  PK FK user_id     : BIGINT
  PK FK comment_id  : BIGINT
  --
  created_at        : TIMESTAMPTZ
}

' ── Relationships ─────────────────────────────
users        ||--o{ posts          : "writes"
users        ||--o{ comments       : "writes"
users        ||--o{ notifications  : "receives"
users        ||--o{ notifications  : "triggers (actor)"
posts        ||--o{ comments       : "has"
posts        ||--o{ media_files    : "contains"

' Pivot relations
users        ||--o{ post_likes     : ""
posts        ||--o{ post_likes     : ""

users        ||--o{ user_follows   : "follower"
users        ||--o{ user_follows   : "following"

users        ||--o{ comment_likes  : ""
comments     ||--o{ comment_likes  : ""

@enduml 