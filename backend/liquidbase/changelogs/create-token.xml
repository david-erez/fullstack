<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2" author="fullstack.dev">
        <createTable tableName="token_acces">
            <column name="token_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_token_user" references="users(user_id)"/>
            </column>
            <column name="token" type="VARCHAR(512)">
                <constraints nullable="false"/>
            </column>
            <column name="is_valid" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="expired" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="revoked" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="DATETIME"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
