<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="7" author="fullstack.dev">
        <createTable tableName="notifications">
            <column name="notification_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="is_read" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="created_at" type="DATETIME"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_notif_user" references="users(user_id)"/>
            </column>
            <column name="actor_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_notif_actor" references="users(user_id)"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
