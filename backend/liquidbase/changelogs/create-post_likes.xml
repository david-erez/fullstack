<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="8" author="fullstack.dev">
        <createTable tableName="post_likes">
            <column name="post_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_postlikes_post" references="posts(posts_id)"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_postlikes_user" references="users(user_id)"/>
            </column>
            <column name="created_at" type="DATETIME"/>
        </createTable>
        <addPrimaryKey tableName="post_likes" columnNames="post_id, user_id" constraintName="pk_post_likes"/>
    </changeSet>

</databaseChangeLog>
